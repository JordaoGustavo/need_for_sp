{
  "name": "need-for-sp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Need for SP - jogo de corrida multiplayer 2 players via convite por link, inspirado em NFS Underground 2, pistas de SP.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "signaling": "tsx server/signalingServer.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.18.0"
  }
}
